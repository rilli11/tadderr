<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>لجنة التنظيم</title>
<style>html,body{margin:0;background:#0a1c33;color:#fff;font-family:sans-serif}.l{display:flex;height:100vh;align-items:center;justify-content:center;opacity:.7}</style></head>
<body><div class="l">جارٍ التحميل…</div>
<script>
// المحمّل: يجلب app.html دائمًا بنسخته الأحدث (بدون كاش). التحديث لاحقًا = رفع app.html فقط.
fetch('app.html?t='+Date.now(),{cache:'no-store'}).then(function(r){if(!r.ok)throw 0;return r.text()}).then(function(t){document.open();document.write(t);document.close()}).catch(function(){document.body.innerHTML='<div class="l">تعذّر تحميل app.html — تأكد أنه مرفوع بجانب index.html</div>'});
</script></body></html>
